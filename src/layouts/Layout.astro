---
import SEO from "../components/SEO.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, path, noindex } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Marks the page as script-capable before first paint, so reveal
         animations hide content only when the script that shows it can run. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <SEO title={title} description={description} path={path} noindex={noindex} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <!-- Fonts are self-hosted from /public/fonts (declared in global.css),
         so no page makes requests to Google Fonts. -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Optional per-page additions (e.g. a concept page's own typeface),
         left empty by default so every existing page is unaffected. -->
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />

    <script>
      // Reveal-on-scroll for elements marked `.reveal`. Respects
      // prefers-reduced-motion via the CSS in global.css (which disables
      // the transition entirely), so no JS branching is needed here.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
      );

      document.querySelectorAll(".reveal").forEach((el, i) => {
        el.style.setProperty("--reveal-index", String(i % 6));
        observer.observe(el);
      });

      // Magnetic call to action: the label eases up to 6px towards the
      // pointer. Fine pointers only, never with reduced motion. The button
      // itself (its hit area) doesn't move.
      const magneticOk = window.matchMedia("(pointer: fine) and (prefers-reduced-motion: no-preference)");
      document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((btn) => {
        btn.addEventListener("pointermove", (e) => {
          if (!magneticOk.matches) return;
          const r = btn.getBoundingClientRect();
          const dx = (e.clientX - (r.left + r.width / 2)) / (r.width / 2);
          const dy = (e.clientY - (r.top + r.height / 2)) / (r.height / 2);
          btn.style.setProperty("--mx", `${(dx * 6).toFixed(1)}px`);
          btn.style.setProperty("--my", `${(dy * 3).toFixed(1)}px`);
        });
        btn.addEventListener("pointerleave", () => {
          btn.style.removeProperty("--mx");
          btn.style.removeProperty("--my");
        });
      });
    </script>
  </body>
</html>
