---
// Case study page for Leroy Driving Instructor — a genuine, live, paid
// client project (unlike the Interactive Concepts pages, which are
// fictional and deliberately run their own separate brand system). This
// page stays inside Stapled's own DESIGN.md system throughout.
import Layout from "../../layouts/Layout.astro";
import Wordmark from "../../components/Wordmark.astro";
import Footer from "../../components/Footer.astro";
import FinalCTA from "../../components/sections/FinalCTA.astro";
import BrowserMockup from "../../components/mockups/BrowserMockup.astro";
import PhoneMockup from "../../components/mockups/PhoneMockup.astro";
import FallbackScreen from "../../components/mockups/FallbackScreen.astro";
import { images, leroyDrivingInstructorUrl } from "../../data/config";

const features = [
  {
    n: "01",
    title: "Genuine Google reviews",
    body: "Real pupil reviews pulled through from Google, not generic testimonials.",
  },
  {
    n: "02",
    title: "Passed-pupil photos",
    body: "A gallery celebrating real driving-test passes, building trust with prospective pupils.",
  },
  {
    n: "03",
    title: "Transparent lesson pricing",
    body: "Clear, upfront rates so visitors know the cost before they ever need to ask.",
  },
  {
    n: "04",
    title: "Responsive carousels",
    body: "Smooth, touch-friendly review and photo carousels that work well on any screen size.",
  },
  {
    n: "05",
    title: "Prominent mobile contact controls",
    body: "Sticky Call, WhatsApp and Enquire actions always within reach on mobile.",
  },
];

const services = [
  "Website design",
  "Astro development",
  "Mobile optimisation",
  "WhatsApp conversion flow",
  "Google review integration",
  "Domain and hosting setup",
];
---

<Layout
  title="Leroy Driving Instructor — Stapled. portfolio"
  description="A conversion-focused website for an independent driving instructor in Brighton & Hove, built to generate more telephone and WhatsApp enquiries."
  path="/work/leroy-driving-instructor"
>
  <header class="lc-topbar">
    <div class="container lc-topbar__inner">
      <a href="/" class="lc-topbar__brand" aria-label="Stapled. — home">
        <Wordmark size="md" />
      </a>
      <a href="/#work" class="link-arrow lc-topbar__back">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back to portfolio
      </a>
    </div>
  </header>

  <main id="main" class="lc">
    <section class="lc-hero section--tight">
      <div class="container lc-hero__inner">
        <div class="lc-hero__copy reveal">
          <span class="lc-status">Live Client Project</span>
          <h1 class="lc-hero__heading">Leroy Driving Instructor</h1>

          <ul class="lc-meta">
            <li>Brighton &amp; Hove</li>
            <li>Website Design &amp; Development</li>
          </ul>

          <p class="lc-hero__body">
            A conversion-focused website for an independent driving
            instructor, designed to generate more telephone and WhatsApp
            enquiries while showcasing genuine Google reviews and pupil
            success stories.
          </p>

          <div class="lc-hero__actions">
            <a href={leroyDrivingInstructorUrl} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
              View Live Website
            </a>
          </div>
        </div>

        <div class="lc-hero__visual reveal" style="--reveal-index: 1">
          <div class="lc-hero__desktop">
            <BrowserMockup src={images.leroyDesktop} alt="Leroy Driving Instructor website homepage on desktop" url="leroydrivinginstructor.co.uk" priority>
              <Fragment slot="fallback">
                <FallbackScreen variant="leroy-desktop" />
              </Fragment>
            </BrowserMockup>
          </div>
          <div class="lc-hero__mobile">
            <PhoneMockup src={images.leroyMobile} alt="Leroy Driving Instructor website homepage on mobile" priority>
              <Fragment slot="fallback">
                <FallbackScreen variant="leroy-mobile" />
              </Fragment>
            </PhoneMockup>
          </div>
        </div>
      </div>
    </section>

    <section class="lc-story section">
      <div class="container">
        <div class="lc-story__intro reveal">
          <p class="eyebrow">The brief</p>
          <h2 class="lc-heading">From outdated to easy to contact.</h2>
        </div>

        <div class="lc-panel reveal">
          <div class="lc-side lc-side--need">
            <p class="lc-label">The need</p>
            <p>
              Leroy's existing web presence was outdated and made it harder
              than it should be for prospective pupils to get in touch. He
              needed a website that replaced it and made contacting him as
              simple as possible.
            </p>
          </div>
          <div class="lc-side lc-side--solution">
            <p class="lc-label lc-label--lime">The solution</p>
            <p>
              A modern, mobile-first website centred entirely around Call
              and WhatsApp actions — built so a prospective pupil can reach
              Leroy in a tap, from anywhere on the site.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="lc-features section" data-dark>
      <div class="container">
        <div class="lc-features__intro reveal">
          <p class="eyebrow">Key features</p>
          <h2 class="lc-heading">Built to turn visitors into pupils.</h2>
        </div>

        <ul class="lc-features__list">
          {features.map((f) => (
            <li class="lc-features__item reveal">
              <span class="lc-features__num">{f.n}</span>
              <div>
                <h3>{f.title}</h3>
                <p class="text-muted">{f.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="lc-services section--tight">
      <div class="container">
        <div class="lc-services__intro reveal">
          <p class="eyebrow">Services provided</p>
          <h2 class="lc-heading">What the project involved.</h2>
        </div>

        <ul class="lc-services__list reveal">
          {services.map((s) => (
            <li>{s}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="lc-outcome section--tight">
      <div class="container lc-outcome__inner reveal">
        <p class="eyebrow">The outcome</p>
        <h2 class="lc-heading">A live website, a new domain, and an easier way to get in touch.</h2>
        <p class="lc-outcome__body">
          Leroy Driving Instructor is now live at leroydrivinginstructor.co.uk,
          replacing the old web presence with a modern, mobile-first site
          built specifically for how prospective pupils actually browse —
          on their phone, looking to call or message rather than fill in a
          form. The domain and hosting were set up as part of the project,
          and every page keeps Call and WhatsApp within a single tap.
        </p>
      </div>
    </section>
  </main>

  <FinalCTA />
  <Footer />
</Layout>

<style>
  .lc-topbar {
    border-bottom: 1px solid var(--colour-border);
  }

  .lc-topbar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.1rem;
  }

  .lc-topbar__brand {
    text-decoration: none;
  }

  .lc-topbar__back svg {
    transform: scaleX(-1);
  }

  .lc-heading {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-top: 0.75rem;
  }

  /* Hero ------------------------------------------------------------ */

  .lc-hero {
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }

  .lc-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  .lc-status {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--colour-lime-ink);
    background: var(--colour-lime);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
  }

  .lc-hero__heading {
    font-size: clamp(2.4rem, 5.4vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-top: 1rem;
  }

  .lc-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  .lc-meta li {
    border: 1px solid var(--colour-border);
    border-radius: 999px;
    padding: 0.4rem 0.95rem;
    font-size: 0.82rem;
    color: var(--colour-muted);
  }

  .lc-hero__body {
    margin-top: 1.5rem;
    font-size: 1.1rem;
    color: var(--colour-muted);
    max-width: 46ch;
  }

  .lc-hero__actions {
    margin-top: 2rem;
  }

  .lc-hero__visual {
    position: relative;
    padding-block: 1rem 2.5rem;
  }

  .lc-hero__desktop {
    width: min(100%, 560px);
    margin-inline: auto;
  }

  .lc-hero__mobile {
    position: absolute;
    width: 34%;
    max-width: 150px;
    right: 2%;
    bottom: -0.5rem;
    filter: drop-shadow(0 20px 30px rgb(17 17 17 / 0.18));
  }

  /* Need / solution panel -------------------------------------------- */

  .lc-story__intro {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    max-width: 46ch;
  }

  .lc-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--colour-border);
  }

  .lc-side {
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .lc-side p:not(.lc-label) {
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .lc-side--need {
    background: #eae7e0;
    color: var(--colour-muted);
  }

  .lc-side--solution {
    background: var(--colour-ink);
    color: var(--colour-bg);
  }

  .lc-side--solution p:not(.lc-label) {
    color: rgb(245 243 238 / 0.8);
  }

  .lc-label {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .lc-label--lime {
    color: var(--colour-lime);
  }

  /* Key features ------------------------------------------------------ */

  .lc-features__intro {
    max-width: 46ch;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .lc-features__list {
    border-top: 1px solid rgb(245 243 238 / 0.15);
  }

  .lc-features__item {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.75rem;
    border-bottom: 1px solid rgb(245 243 238 / 0.15);
  }

  .lc-features__num {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--colour-lime-ink);
    background: var(--colour-lime);
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .lc-features__item h3 {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }

  /* Services provided --------------------------------------------------- */

  .lc-services__intro {
    max-width: 46ch;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .lc-services__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .lc-services__list li {
    border: 1px solid var(--colour-border);
    border-radius: 999px;
    padding: 0.6rem 1.15rem;
    font-size: 0.9rem;
  }

  /* Outcome ------------------------------------------------------------- */

  .lc-outcome__inner {
    max-width: 720px;
  }

  .lc-outcome__body {
    margin-top: 1.5rem;
    font-size: 1.05rem;
    color: var(--colour-muted);
  }

  @media (min-width: 720px) {
    .lc-services__intro,
    .lc-outcome__inner {
      max-width: none;
    }
  }

  @media (min-width: 780px) {
    .lc-hero__inner {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    }

    .lc-panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .lc-features__item {
      grid-template-columns: 4rem minmax(0, 1fr);
    }

    .lc-features__item > div {
      display: grid;
      grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
      gap: 2rem;
      align-items: baseline;
    }
  }
</style>
