---
// Homepage. Each section has one job: the hero says what Stapled. does and
// shows it (the bathroom concept), the note beneath explains that concept,
// then services, how useful features work (the customer story), how
// working together happens, who Matt is, and how to get in touch.
import SiteLayout from "../layouts/SiteLayout.astro";
import Hero from "../components/home/Hero.astro";
import ServiceIndex from "../components/home/ServiceIndex.astro";
import DemoNote from "../components/home/DemoNote.astro";
import Story from "../components/home/Story.astro";
import WorkingTogether from "../components/home/WorkingTogether.astro";
import ContactBand from "../components/ui/ContactBand.astro";
---

<SiteLayout>
  <Hero />
  <DemoNote />
  <ServiceIndex />
  <Story />
  <WorkingTogether />

  <section class="about section" aria-labelledby="about-heading">
    <div class="container about__inner">
      <p class="eyebrow">About</p>
      <div class="about__body">
        <h2 id="about-heading" class="about__heading">Hello, I'm Matt.</h2>
        <div>
          <p class="lead">
            I'm the person behind Stapled. I design and build every website
            myself and stay on hand once it's live, so you always know who
            you're talking to.
          </p>
          <a href="/about/" class="link-arrow about__more">
            More about how I work
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <ContactBand />
</SiteLayout>

<!-- The old one-page site used homepage anchors (/#pricing, /#preview…).
     Send anyone arriving on one of those to the page that replaced it. -->
<script is:inline>
  (function () {
    var moved = {
      "#preview": "/contact/",
      "#pricing": "/services/#pricing",
      "#faq": "/services/#faq",
      "#process": "/services/",
      "#work": "/possibilities/",
      "#concepts": "/possibilities/",
      "#about": "/about/",
      "#transform": "/services/",
    };
    var to = moved[window.location.hash];
    if (to) window.location.replace(to);
  })();
</script>

<style>
  .about {
    background: var(--colour-white);
    border-top: 1px solid var(--colour-border);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .about__body {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .about__heading {
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1;
    font-weight: 650;
    letter-spacing: -0.035em;
  }

  .about__more {
    margin-top: 1rem;
  }

  @media (max-width: 860px) {
    .about__body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
