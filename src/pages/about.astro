---
// About Matt. The staple mark stands in for a photo until Matt supplies
// one: never a stock photo.
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import ContactBand from "../components/ui/ContactBand.astro";
import { site } from "../data/config";

const principles = [
  {
    title: "One person, start to finish",
    body: "You talk to me from the first conversation to launch, and afterwards if I'm looking after your site. No hand-offs, no account managers.",
  },
  {
    title: "Plain English",
    body: "I'll explain what I'm doing and why, without jargon. If something won't help your business, I'll say so.",
  },
  {
    title: "Realistic advice",
    body: "I'll tell you what's likely to make a difference for your business, and what isn't worth the money.",
  },
  {
    title: "Your real work, front and centre",
    body: "Your photos, your reviews and your words, so customers see the business they'll actually be dealing with.",
  },
];
---

<SiteLayout
  title="About Matt | Stapled."
  description="Stapled. is run by Matt, who designs, builds and looks after websites for trade and service businesses. Serving Southampton and businesses across the UK."
  path="/about/"
>
  <PageHero
    eyebrow="About"
    heading="You'll deal with me, start to finish."
  />

  <section class="intro" aria-label="About Matt">
    <div class="container intro__grid">
      <div class="intro__copy">
        <p class="lead intro__lead">
          Hello, I'm Matt. I design, build and look after websites for trade
          and service businesses, and help them get the basics of being found
          on Google right. You'll deal with me directly, from the first chat
          to launch and beyond.
        </p>
        <p class="intro__text">
          Good trade businesses often have websites that don't do them justice:
          hard to use on a phone, short on real photos, or vague about what they
          do and where. My job is to fix that, so the website shows the same
          care you put into your work.
        </p>
        <p class="intro__place">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-6.2 7-12a7 7 0 10-14 0c0 5.8 7 12 7 12z" stroke="currentColor" stroke-width="1.6"></path><circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.6"></circle></svg>
          {site.location}
        </p>
      </div>
    </div>
  </section>

  <section class="ways section" aria-labelledby="ways-heading">
    <div class="container">
      <p class="eyebrow">How I work</p>
      <h2 id="ways-heading" class="headline ways__heading">What you can expect.</h2>
      <ul class="ways__grid">
        {principles.map((p) => (
          <li class="ways__item reveal">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ContactBand />
</SiteLayout>

<style>
  .intro {
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 52rem;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .intro__text {
    margin-top: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--colour-text-2);
    max-width: 58ch;
  }

  .intro__place {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
  }

  .intro__place svg {
    width: 1.2rem;
    height: 1.2rem;
    flex-shrink: 0;
  }

  .ways {
    background: var(--colour-white);
    border-top: 1px solid var(--colour-border);
  }

  .ways__heading {
    margin-top: 1.5rem;
  }

  .ways__grid {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .ways__item {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-lg);
    background: var(--colour-bg);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ways__item h3 {
    font-size: 1.4rem;
  }

  .ways__item p {
    color: var(--colour-text-2);
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .intro__grid,
    .ways__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
