---
// Contact: email only for now. A form service will be assessed separately
// before launch (it needs a published data processing agreement, data
// location and retention; see the private asset register). Don't add one here.
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import { contact } from "../data/config";

const subject = "Talk about my business";
const body = [
  "Hi Matt,",
  "",
  "My name:",
  "Business name:",
  "What the business does, and where:",
  "Current website or social media page (if any):",
  "What I'd like help with:",
  "",
].join("\n");
const mailto = `mailto:${contact.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const next = [
  { title: "I reply personally", body: "Usually with a few questions, or to suggest a quick call if that's easier." },
  { title: "We talk it through", body: "Your work, your customers and what you need. Where it helps, I may put together a quick homepage preview." },
  { title: "You get a written quote", body: "What's included and the total price. Nothing is payable unless you accept it." },
];
---

<SiteLayout
  title="Contact | Talk about your business | Stapled."
  description="Email Matt about your business. You'll get a personal reply and, once I understand what you need, a clear written quote."
  path="/contact/"
>
  <PageHero
    eyebrow="Contact"
    heading="Talk about your business."
    lead="A short email is enough to start. Tell me a little about what you do and what you need, and I'll reply personally."
  />

  <section class="contact" aria-label="How to get in touch">
    <div class="container contact__grid">
      <div class="contact__card" data-dark>
        <h2 class="contact__heading">Email me</h2>
        <p class="contact__intro">It helps to include:</p>
        <ul class="contact__include">
          <li>your name and business name</li>
          <li>what the business does, and where</li>
          <li>your current website or social media page, if you have one</li>
          <li>what you'd like help with</li>
        </ul>
        <p class="contact__note">Add a phone number only if you'd rather I called you.</p>
        <a href={mailto} class="btn btn--lime contact__btn">Email {contact.email}</a>
        <p class="contact__small">
          The button opens your email app with these headings filled in. If it
          doesn't, write to <a href={`mailto:${contact.email}`}>{contact.email}</a>.
          I use your details to reply to you. See the <a href="/privacy/">privacy policy</a>.
        </p>
      </div>

      <div class="contact__next">
        <h2 class="contact__next-heading">What happens next</h2>
        <ol class="contact__steps">
          {next.map((n, i) => (
            <li>
              <span aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{n.title}</h3>
                <p>{n.body}</p>
              </div>
            </li>
          ))}
        </ol>
        {contact.instagramLink && (
          <p class="contact__social">
            You can also find me on Instagram:{" "}
            <a href={contact.instagramLink} target="_blank" rel="noopener noreferrer">
              {contact.instagramHandle}<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </p>
        )}
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .contact {
    padding-bottom: clamp(4rem, 9vw, 8rem);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .contact__card {
    border-radius: var(--radius-xl);
    padding: clamp(1.75rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact__heading {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }

  .contact__intro {
    color: var(--colour-on-dark-muted);
  }

  .contact__include {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact__include li {
    position: relative;
    padding-left: 1.4rem;
  }

  .contact__include li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--colour-lime);
  }

  .contact__note,
  .contact__small {
    font-size: 0.9rem;
    color: var(--colour-on-dark-muted);
    line-height: 1.55;
  }

  .contact__btn {
    align-self: flex-start;
    margin-block: 0.5rem;
    overflow-wrap: anywhere;
  }

  .contact__small a {
    color: var(--colour-bg);
    text-underline-offset: 0.2em;
  }

  .contact__next-heading {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }

  .contact__steps {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .contact__steps li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--colour-border);
  }

  .contact__steps span {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--colour-muted);
  }

  .contact__steps h3 {
    font-size: 1.25rem;
  }

  .contact__steps p {
    margin-top: 0.35rem;
    color: var(--colour-text-2);
    line-height: 1.55;
  }

  .contact__social {
    margin-top: 1.5rem;
    color: var(--colour-text-2);
  }

  .contact__social a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--colour-ink);
    font-weight: 600;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 860px) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
