---
// Contact: email only. No form service is configured (FormSubmit was removed
// on 22 Oct 2026); a real form needs Matt to choose a provider with a
// published data processing agreement, data location and retention. Don't
// add a form, or pretend to submit one, until then.
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import { contact } from "../data/config";

const subject = "Talk about my business";
const body = [
  "Hi Matt,",
  "",
  "My name:",
  "Business name:",
  "What the business does, and where:",
  "Current website or social media page (if any):",
  "What I'd like help with:",
  "",
].join("\n");
const mailto = `mailto:${contact.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const include = [
  "your name and business name",
  "what the business does, and where",
  "your current website or social media page, if you have one",
  "what you'd like help with",
];

const next = [
  { title: "I reply personally", body: "Usually with a few questions, or to suggest a quick call if that's easier." },
  { title: "We talk it through", body: "Your work, your customers and what you need. Where it helps, I may put together a quick homepage preview." },
  { title: "You get a written quote", body: "What's included and the total price. Nothing is payable unless you accept it." },
];
---

<SiteLayout
  title="Contact | Talk about your business | Stapled."
  description="Email Matt about your business. You'll get a personal reply and, once I understand what you need, a clear written quote."
  path="/contact/"
>
  <PageHero
    eyebrow="Contact"
    heading="Talk about your business."
    lead="A short email is enough to start. Tell me a little about what you do and what you need, and I'll reply personally."
  >
    <div class="reach">
      <a href={mailto} class="btn btn--lime reach__btn">
        Email Matt
        <svg class="btn__arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
      <div class="reach__address">
        <a href={`mailto:${contact.email}`} class="reach__email">{contact.email}</a>
        <button type="button" class="reach__copy" data-copy={contact.email} hidden>
          <span class="reach__copy-label">Copy address</span>
        </button>
        <span class="reach__status" role="status" aria-live="polite"></span>
      </div>
    </div>
    <p class="reach__hint">
      The button opens your email app with a few headings filled in. Prefer
      to write your own? Use the address above.
    </p>
  </PageHero>

  <section class="contact" aria-label="What to include and what happens next">
    <div class="container contact__grid">
      <div class="contact__card">
        <h2 class="contact__heading">It helps to include</h2>
        <ul class="contact__include">
          {include.map((item) => <li>{item}</li>)}
        </ul>
        <p class="contact__note">
          Add a phone number only if you'd rather I called you. I use your
          details to reply to you; see the <a href="/privacy/">privacy policy</a>.
        </p>
      </div>

      <div class="contact__next">
        <h2 class="contact__heading">What happens next</h2>
        <ol class="contact__steps">
          {next.map((n, i) => (
            <li>
              <span aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{n.title}</h3>
                <p>{n.body}</p>
              </div>
            </li>
          ))}
        </ol>
        {contact.instagramLink && (
          <p class="contact__social">
            You can also find me on Instagram:{" "}
            <a href={contact.instagramLink} target="_blank" rel="noopener noreferrer">
              {contact.instagramHandle}<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </p>
        )}
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    if (!navigator.clipboard) continue;
    btn.hidden = false;
    const label = btn.querySelector(".reach__copy-label");
    const status = btn.parentElement?.querySelector(".reach__status");
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        btn.classList.add("is-done");
        if (label) label.textContent = "Copied";
        if (status) status.textContent = "Email address copied";
        setTimeout(() => {
          btn.classList.remove("is-done");
          if (label) label.textContent = "Copy address";
          if (status) status.textContent = "";
        }, 2200);
      } catch {
        if (status) status.textContent = "Couldn't copy. Select the address instead.";
      }
    });
  }
</script>

<style>
  .reach {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .reach__address {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
  }

  .reach__email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration-color: var(--colour-border);
    text-underline-offset: 0.3em;
    overflow-wrap: anywhere;
  }

  .reach__email:hover {
    text-decoration-color: currentColor;
  }

  .reach__copy {
    position: relative;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1px solid var(--colour-border);
    background: var(--colour-white);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.3s var(--ease-out), background 0.3s var(--ease-out), transform 0.2s var(--ease-out);
  }

  .reach__copy:hover {
    border-color: var(--colour-ink);
  }

  .reach__copy:active {
    transform: scale(0.97);
  }

  .reach__copy.is-done {
    background: var(--colour-lime);
    border-color: var(--colour-lime);
    color: var(--colour-lime-ink);
  }

  .reach__status {
    font-size: 0.85rem;
    color: var(--colour-muted);
  }

  .reach__status:empty {
    display: none;
  }

  .reach__hint {
    margin-top: 1rem;
    max-width: 52ch;
    font-size: 0.9rem;
    color: var(--colour-muted);
  }

  .contact {
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .contact__card {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--colour-border);
    background: var(--colour-white);
  }

  .contact__heading {
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
  }

  .contact__include {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.6rem;
  }

  .contact__include li {
    position: relative;
    padding-left: 1.4rem;
  }

  .contact__include li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--colour-lime);
    outline: 1px solid var(--colour-lime-ink);
    outline-offset: -1px;
  }

  .contact__note {
    margin-top: 1.25rem;
    font-size: 0.9rem;
    color: var(--colour-text-2);
    line-height: 1.55;
  }

  .contact__note a {
    text-underline-offset: 0.2em;
  }

  .contact__steps {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
  }

  .contact__steps li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--colour-border);
  }

  .contact__steps span {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--colour-muted);
  }

  .contact__steps h3 {
    font-size: 1.2rem;
  }

  .contact__steps p {
    margin-top: 0.3rem;
    color: var(--colour-text-2);
    line-height: 1.55;
  }

  .contact__social {
    margin-top: 1.25rem;
    color: var(--colour-text-2);
  }

  .contact__social a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--colour-ink);
    font-weight: 600;
    text-underline-offset: 0.2em;
  }

  @media (prefers-reduced-motion: reduce) {
    .reach__copy {
      transition: none;
    }
  }

  @media (max-width: 860px) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
