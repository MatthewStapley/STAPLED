---
// Small, drawn-in-code illustrations of what a feature looks like. They
// stand in for project screenshots until Matt approves which real projects
// and demos to show, so they are deliberately generic ("Your business") and
// always decorative: whatever places one must label it as illustrative.
import type { IllustrationVariant } from "../../data/services";

interface Props {
  variant: IllustrationVariant;
  class?: string;
}

const { variant, class: className = "" } = Astro.props;
---

<div class:list={["ill", `ill--${variant}`, className]} aria-hidden="true">
  {variant === "website" && (
    <div class="ill-card ill-browser">
      <div class="ill-bar"><i></i><i></i><i></i><span>yourbusiness.co.uk</span></div>
      <div class="ill-pad ill-stack">
        <p class="ill-title">Roofing done properly, across your area.</p>
        <div class="ill-photo ill-photo--tall"></div>
        <span class="ill-cta">Request a quote</span>
      </div>
    </div>
  )}

  {variant === "profile" && (
    <div class="ill-card ill-pad ill-stack ill-white">
      <p class="ill-meta">Business profile</p>
      <p class="ill-name">Your Business Roofing</p>
      <p class="ill-meta">Roofer · Serves your area</p>
      <div class="ill-photo ill-photo--light"></div>
      <div class="ill-pills"><span>Website</span><span>Call</span><span>Directions</span></div>
    </div>
  )}

  {variant === "enquiry" && (
    <div class="ill-card ill-pad ill-stack">
      <p class="ill-meta">New enquiry</p>
      <p class="ill-title ill-title--sm">Quote request</p>
      <dl class="ill-kv">
        <div><dt>Job</dt><dd>Roof repair</dd></div>
        <div><dt>Area</dt><dd>Postcode district</dd></div>
        <div><dt>Photos</dt><dd>2 attached</dd></div>
        <div><dt>Best contact</dt><dd>Phone call</dd></div>
      </dl>
    </div>
  )}

  {variant === "gallery" && (
    <div class="ill-card ill-pad ill-stack">
      <p class="ill-meta">Recent projects</p>
      <div class="ill-grid">
        <div class="ill-photo"></div><div class="ill-photo ill-photo--light"></div>
        <div class="ill-photo ill-photo--light"></div><div class="ill-photo"></div>
      </div>
      <div class="ill-ba"><span>Before</span><span class="ill-ba__handle"></span><span>After</span></div>
    </div>
  )}

  {variant === "call" && (
    <div class="ill-card ill-pad ill-stack ill-phone">
      <p class="ill-title ill-title--sm">Your Business</p>
      <p class="ill-meta">Driveways and patios</p>
      <span class="ill-cta ill-cta--block">Call now</span>
      <span class="ill-cta ill-cta--block ill-cta--outline">Message on WhatsApp</span>
    </div>
  )}

  {variant === "areas" && (
    <div class="ill-card ill-pad ill-stack">
      <p class="ill-meta">Areas covered</p>
      <div class="ill-pins">
        <span>Your town</span><span>Nearby town</span><span>Next village</span><span>Surrounding areas</span>
      </div>
      <div class="ill-line"></div><div class="ill-line ill-line--short"></div>
    </div>
  )}

  {variant === "speed" && (
    <div class="ill-card ill-pad ill-stack">
      <p class="ill-meta">Loading on mobile</p>
      <div class="ill-load"><span></span></div>
      <div class="ill-photo ill-photo--light"></div>
      <div class="ill-line"></div><div class="ill-line ill-line--short"></div>
    </div>
  )}

  {variant === "reviews" && (
    <div class="ill-card ill-pad ill-stack">
      <p class="ill-quote">&ldquo;</p>
      <div class="ill-line"></div><div class="ill-line"></div><div class="ill-line ill-line--short"></div>
      <p class="ill-meta">A real customer, in their own words</p>
    </div>
  )}

  {variant === "care" && (
    <div class="ill-card ill-pad ill-stack">
      <p class="ill-meta">Looked after</p>
      <dl class="ill-kv">
        <div><dt>HTTPS</dt><dd>On</dd></div>
        <div><dt>Weekly backup</dt><dd>Done</dd></div>
        <div><dt>Small change</dt><dd>Updated</dd></div>
      </dl>
    </div>
  )}
</div>

<style>
  .ill {
    width: 100%;
    color: var(--colour-ink);
    font-family: var(--font-body);
  }

  .ill-card {
    background: var(--colour-bg);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 30px 60px -36px rgb(0 0 0 / 0.75);
  }

  .ill-white {
    background: var(--colour-white);
  }

  .ill-pad {
    padding: 1.1rem;
  }

  .ill-stack {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .ill-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.6rem 0.75rem;
    background: var(--colour-white);
    border-bottom: 1px solid var(--colour-paper-2);
  }

  .ill-bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--colour-border);
  }

  .ill-bar span {
    margin-left: 0.5rem;
    font-size: 0.7rem;
    color: var(--colour-muted);
  }

  .ill-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.02;
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .ill-title--sm {
    font-size: 1.15rem;
  }

  .ill-name {
    font-weight: 700;
    font-size: 1rem;
  }

  .ill-meta {
    font-size: 0.72rem;
    color: var(--colour-muted);
  }

  .ill-photo {
    height: 64px;
    border-radius: 10px;
    background: linear-gradient(160deg, #5b5a55, #2e2d2a);
  }

  .ill-photo--tall {
    height: 104px;
  }

  .ill-photo--light {
    background: linear-gradient(160deg, #cfcbc2, #a9a59c);
  }

  .ill-cta {
    align-self: flex-start;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    background: var(--colour-lime);
    color: var(--colour-lime-ink);
    font-weight: 600;
    font-size: 0.75rem;
  }

  .ill-cta--block {
    align-self: stretch;
    text-align: center;
  }

  .ill-cta--outline {
    background: transparent;
    border: 1px solid var(--colour-border);
    color: var(--colour-ink);
  }

  .ill-pills,
  .ill-pins {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .ill-pills span,
  .ill-pins span {
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--colour-border);
    background: var(--colour-white);
    font-size: 0.68rem;
  }

  .ill-kv {
    margin: 0;
  }

  .ill-kv div {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 0.45rem;
    border-bottom: 1px solid var(--colour-paper-2);
    font-size: 0.78rem;
  }

  .ill-kv div:last-child {
    border-bottom: 0;
  }

  .ill-kv dt {
    color: var(--colour-muted);
  }

  .ill-kv dd {
    margin: 0;
  }

  .ill-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .ill-grid .ill-photo {
    height: 46px;
  }

  .ill-ba {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    font-size: 0.68rem;
    color: var(--colour-muted);
  }

  .ill-ba__handle {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--colour-border) 50%, var(--colour-ink) 50%);
  }

  .ill-line {
    height: 8px;
    border-radius: 4px;
    background: var(--colour-border);
  }

  .ill-line--short {
    width: 60%;
  }

  .ill-load {
    height: 8px;
    border-radius: 4px;
    background: var(--colour-paper-2);
    overflow: hidden;
  }

  .ill-load span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--colour-lime);
  }

  .ill-quote {
    font-family: var(--font-display);
    font-size: 2.5rem;
    line-height: 0.6;
    font-weight: 700;
    padding-top: 0.4rem;
  }

  .ill-phone {
    max-width: 15rem;
    margin-inline: auto;
    border-radius: 24px;
  }
</style>
