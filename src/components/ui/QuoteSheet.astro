---
// An example layout of a written quote: the visual for "pricing on
// enquiry". It never shows a figure. Fastened with the staple, and it
// settles into place as it scrolls in (motion only, never required).
import StapleMark from "./StapleMark.astro";
---

<figure class="sheet">
  <StapleMark class="sheet__staple" tone="lime" />
  <div class="sheet__head">
    <p class="sheet__title">Quote</p>
    <span class="tag">Example layout</span>
  </div>
  <dl class="sheet__rows">
    <div><dt>Prepared for</dt><dd>[Your business]</dd></div>
    <div><dt>Prepared by</dt><dd>Matt, Stapled.</dd></div>
    <div><dt>What's included</dt><dd>Pages, features and content agreed together</dd></div>
    <div><dt>Hosting and care</dt><dd>Optional, set out separately</dd></div>
    <div class="sheet__total"><dt>Total price</dt><dd>Written in your quote</dd></div>
  </dl>
  <figcaption class="visually-hidden">An example of how a written quote from Stapled. is laid out. It shows no real prices.</figcaption>
</figure>

<style>
  .sheet {
    position: relative;
    margin: 0;
    background: var(--colour-white);
    border: 1px solid var(--colour-border);
    border-radius: 6px;
    padding: clamp(2.5rem, 4vw, 3.25rem) clamp(1.5rem, 3vw, 2.75rem) clamp(1.75rem, 3vw, 2.75rem);
    box-shadow: 0 40px 80px -40px rgb(17 17 17 / 0.3);
    transform: rotate(-1.5deg);
  }

  .sheet :global(.sheet__staple) {
    position: absolute;
    top: -12px;
    left: 2.5rem;
    width: 84px;
    height: auto;
  }

  .sheet__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .sheet__title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .sheet__rows {
    margin: 0;
  }

  .sheet__rows div {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--colour-paper-2);
    font-size: 0.95rem;
  }

  .sheet__rows dt {
    color: var(--colour-muted);
    flex-shrink: 0;
  }

  .sheet__rows dd {
    margin: 0;
    text-align: right;
  }

  .sheet__rows .sheet__total {
    border-bottom: 0;
    font-weight: 600;
  }

  .sheet__rows .sheet__total dt {
    color: var(--colour-ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .sheet {
        animation: sheet-settle linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 40%;
      }
    }
  }

  @keyframes sheet-settle {
    from {
      transform: rotate(4deg) translateY(60px);
    }
    to {
      transform: rotate(-1.5deg);
    }
  }

  @media (max-width: 640px) {
    .sheet {
      transform: none;
    }

    .sheet__rows div {
      flex-direction: column;
      gap: 0.2rem;
    }

    .sheet__rows dd {
      text-align: left;
    }
  }
</style>
