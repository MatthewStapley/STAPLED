---
// The FORM Bathrooms concept, presented on real screenshots of the finished
// demo site (captured 28 Oct 2026). It's a fictional brand: always labelled
// as a concept, and its photography is Unsplash inspiration, never Stapled.
// or client work. Photographers are credited in the demo itself.
//
// Interactions (all optional; the section is complete without them):
// - a Desktop/Mobile switch that brings either device forward, with the
//   staple "pressing" under the active option;
// - the devices settle from a slight tilt as the section comes into view;
// - on fine pointers, a little depth that follows the cursor.
import { bathroomDemoUrl } from "../../data/config";

interface Props {
  id?: string;
  headingLevel?: "h2" | "h3";
  eyebrow?: string;
  heading?: string;
}

const {
  id = "demo",
  headingLevel: H = "h2",
  eyebrow = "Concept website",
  heading = "A bathroom company website, built to show the work.",
} = Astro.props;

const img = (name: string) => `/images/form-demo/${name}`;
---

<section class="demo" id={id} data-graphite data-demo aria-labelledby={`${id}-heading`}>
  <div class="container demo__inner">
    <div class="demo__copy">
      <p class="eyebrow">{eyebrow}</p>
      <H id={`${id}-heading`} class="demo__heading">{heading}</H>
      <p class="lead demo__lead">
        FORM Bathrooms is a fictional brand I designed and built to show what a
        renovation company's website can feel like.
      </p>
      <ul class="demo__points">
        <li>Scroll-led storytelling, chapter by chapter</li>
        <li>Material styles compared side by side</li>
        <li>An inspiration gallery with a full-screen viewer</li>
        <li>Clear routes to an enquiry on every screen</li>
      </ul>
      <div class="demo__actions">
        <a class="btn btn--lime" href={bathroomDemoUrl}>
          Explore the bathroom demo
          <svg class="btn__arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      </div>
      <p class="demo__credit">
        A concept, not client work. Photography is Unsplash inspiration,
        credited in the demo.
      </p>
    </div>

    <div class="demo__visual">
      <div class="demo__switch" role="group" aria-label="Preview the demo on" data-demo-switch hidden>
        <button type="button" class="demo__opt" data-view="desktop" aria-pressed="true">
          Desktop
          <svg class="demo__staple" viewBox="0 0 40 14" aria-hidden="true"><path class="demo__staple-legs" d="M3 3v9M37 3v9"></path><path class="demo__staple-crown" d="M3 3h34"></path></svg>
        </button>
        <button type="button" class="demo__opt" data-view="mobile" aria-pressed="false">
          Mobile
          <svg class="demo__staple" viewBox="0 0 40 14" aria-hidden="true"><path class="demo__staple-legs" d="M3 3v9M37 3v9"></path><path class="demo__staple-crown" d="M3 3h34"></path></svg>
        </button>
      </div>

      <div class="demo__stage" data-view="desktop">
        <div class="demo__devices">
          <figure class="laptop">
            <div class="laptop__screen">
              <img
                src={img("desktop-1600.webp")}
                srcset={`${img("desktop-960.webp")} 960w, ${img("desktop-1600.webp")} 1600w`}
                sizes="(min-width: 1100px) 720px, 90vw"
                width="1600"
                height="1000"
                loading="lazy"
                decoding="async"
                alt="The FORM Bathrooms concept homepage on a laptop: the headline 'A better beginning. Every day.' beside a photo of a stone vanity and arched mirror."
              />
            </div>
            <div class="laptop__base" aria-hidden="true"></div>
          </figure>
          <figure class="phone">
            <div class="phone__screen">
              <img
                src={img("mobile-390.webp")}
                srcset={`${img("mobile-390.webp")} 390w, ${img("mobile-780.webp")} 780w`}
                sizes="(min-width: 1100px) 240px, 46vw"
                width="390"
                height="844"
                loading="lazy"
                decoding="async"
                alt="The same concept on a phone, with the headline and buttons stacked above the photo."
              />
            </div>
          </figure>
        </div>
        <span class="demo__badge">Concept website</span>
      </div>
    </div>
  </div>
</section>

<style>
  .demo {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    overflow: hidden;
  }

  .demo__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .demo__heading {
    margin-top: 1.25rem;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.02;
    font-weight: 620;
    letter-spacing: -0.03em;
  }

  .demo__lead {
    margin-top: 1.25rem;
  }

  .demo__points {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.55rem;
  }

  .demo__points li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--colour-bg);
  }

  .demo__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--colour-lime);
  }

  .demo__actions {
    margin-top: 2rem;
  }

  .demo__credit {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--colour-on-dark-muted);
    max-width: 40ch;
  }

  /* Switch ---------------------------------------------------------- */
  .demo__switch {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    margin-bottom: 1.5rem;
    border-radius: 999px;
    background: rgb(245 243 238 / 0.08);
    border: 1px solid rgb(245 243 238 / 0.14);
  }

  .demo__switch[hidden] {
    display: none;
  }

  .demo__opt {
    position: relative;
    min-height: 44px;
    padding: 0 1.25rem 0.35rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--colour-on-dark-muted);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: color 0.3s var(--ease-out), background 0.3s var(--ease-out);
  }

  .demo__opt:hover {
    color: var(--colour-bg);
  }

  .demo__opt[aria-pressed="true"] {
    color: var(--colour-bg);
    background: rgb(245 243 238 / 0.1);
  }

  /* The staple under the active option: the crown draws, then the legs
     press down. It's the same "fasten" as the hero headline. */
  .demo__staple {
    position: absolute;
    left: 50%;
    bottom: 5px;
    width: 26px;
    height: 9px;
    translate: -50% 0;
    fill: none;
    stroke-width: 2.4;
    stroke-linecap: round;
    overflow: visible;
    opacity: 0;
  }

  .demo__staple-crown {
    stroke: var(--colour-lime);
    stroke-dasharray: 34;
    stroke-dashoffset: 34;
  }

  .demo__staple-legs {
    stroke: var(--colour-lime);
    transform: translateY(-4px);
    opacity: 0;
  }

  .demo__opt[aria-pressed="true"] .demo__staple {
    opacity: 1;
  }

  .demo__opt[aria-pressed="true"] .demo__staple-crown {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.3s var(--ease-out);
  }

  .demo__opt[aria-pressed="true"] .demo__staple-legs {
    transform: none;
    opacity: 1;
    transition: transform 0.25s var(--ease-out) 0.22s, opacity 0.15s linear 0.22s;
  }

  /* Stage and devices ---------------------------------------------- */
  .demo__visual {
    perspective: 1600px;
  }

  .demo__stage {
    position: relative;
    perspective: 1400px;
  }

  .demo__devices {
    position: relative;
    aspect-ratio: 16 / 11.5;
    transform-style: preserve-3d;
    transform: rotateX(var(--ry, 0deg)) rotateY(var(--rx, 0deg));
    transition: transform 0.6s var(--ease-out);
  }

  .laptop {
    position: absolute;
    left: 0;
    top: 0;
    width: 86%;
    margin: 0;
    transform-origin: 30% 60%;
    transition: transform 0.7s var(--ease-out), opacity 0.7s var(--ease-out), filter 0.7s var(--ease-out);
  }

  .laptop__screen {
    padding: 2.2% 2.2% 2.6%;
    border-radius: 16px 16px 6px 6px;
    background: #0b0c0d;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08), 0 50px 90px -40px rgb(0 0 0 / 0.9);
  }

  .laptop__screen img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .laptop__base {
    height: 14px;
    margin-inline: -5%;
    border-radius: 0 0 14px 14px;
    background: linear-gradient(#2b2d30, #17181a);
    box-shadow: 0 30px 40px -24px rgb(0 0 0 / 0.9);
  }

  .phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 30%;
    margin: 0;
    padding: 2.4%;
    border-radius: 34px;
    background: #0b0c0d;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1), 0 40px 70px -30px rgb(0 0 0 / 0.95);
    transform-origin: 70% 80%;
    transition: transform 0.7s var(--ease-out), opacity 0.7s var(--ease-out), filter 0.7s var(--ease-out);
  }

  .phone__screen {
    overflow: hidden;
    border-radius: 26px;
  }

  .phone__screen img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Mobile view: the phone comes forward, the laptop steps back. */
  .demo__stage[data-view="mobile"] .phone {
    transform: translate(-58%, -6%) scale(1.45);
  }

  .demo__stage[data-view="mobile"] .laptop {
    transform: translateX(-6%) scale(0.92);
    opacity: 0.35;
    filter: saturate(0.6);
  }

  .demo__badge {
    position: absolute;
    top: -0.75rem;
    left: 1rem;
    z-index: 2;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: var(--colour-bg);
    color: var(--colour-ink);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    box-shadow: 0 8px 20px -10px rgb(0 0 0 / 0.6);
  }

  /* Entry: the devices settle from a slight tilt (JS adds .is-in). */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .demo__stage {
      transform: translateY(48px) rotateX(12deg) scale(0.96);
      opacity: 0;
      transform-origin: 50% 100%;
      transition: transform 1.1s var(--ease-out), opacity 0.8s var(--ease-out);
    }

    :global(.js) .demo.is-in .demo__stage {
      transform: none;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo__devices,
    .laptop,
    .phone {
      transition: none;
    }
  }

  @media (max-width: 960px) {
    .demo__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .demo__visual {
      order: -1;
    }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const fine = window.matchMedia("(pointer: fine)");

  for (const section of document.querySelectorAll<HTMLElement>("[data-demo]")) {
    const stage = section.querySelector<HTMLElement>(".demo__stage");
    const devices = section.querySelector<HTMLElement>(".demo__devices");
    const sw = section.querySelector<HTMLElement>("[data-demo-switch]");
    if (!stage || !devices) continue;

    // Switch: only shown when it works.
    if (sw) {
      sw.hidden = false;
      const opts = [...sw.querySelectorAll<HTMLButtonElement>("[data-view]")];
      for (const opt of opts) {
        opt.addEventListener("click", () => {
          stage.dataset.view = opt.dataset.view;
          for (const o of opts) o.setAttribute("aria-pressed", String(o === opt));
        });
      }
    }

    // Entry: reveal once, when the stage is a third of the way into view.
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            section.classList.add("is-in");
            io.disconnect();
          }
        },
        { threshold: 0.25 }
      );
      io.observe(stage);
    } else {
      section.classList.add("is-in");
    }

    // Depth: a few degrees of tilt following the pointer, fine pointers only.
    let frame = 0;
    stage.addEventListener("pointermove", (e) => {
      if (reduce.matches || !fine.matches) return;
      const r = stage.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        devices.style.setProperty("--rx", `${(x * 6).toFixed(2)}deg`);
        devices.style.setProperty("--ry", `${(-y * 4).toFixed(2)}deg`);
      });
    });
    stage.addEventListener("pointerleave", () => {
      cancelAnimationFrame(frame);
      devices.style.setProperty("--rx", "0deg");
      devices.style.setProperty("--ry", "0deg");
    });
  }
</script>
