---
// The Stapled. staple: a flat crown with two legs. Used structurally, to
// "fasten" one thing (a headline word, the quote sheet), never as
// decoration. `animated` draws the crown then presses the legs down once;
// prefers-reduced-motion shows it already fastened.
interface Props {
  class?: string;
  animated?: boolean;
  /** Crown colour. Legs are ink on light grounds unless `mono`. */
  tone?: "lime" | "ink";
  mono?: boolean;
  label?: string;
  /** Stretch to the box it's given (e.g. the width of a word), keeping the
      stroke weight in proportion to the surrounding text. */
  stretch?: boolean;
}

const { class: className = "", animated = false, tone = "lime", mono = false, label, stretch = false } = Astro.props;
const crown = tone === "lime" ? "var(--colour-lime)" : "var(--colour-ink)";
const legs = mono ? crown : "var(--colour-ink)";
---

<svg
  class:list={["staple", className, { "staple--animated": animated, "staple--stretch": stretch }]}
  viewBox="0 0 120 48"
  preserveAspectRatio={stretch ? "none" : undefined}
  fill="none"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <path class="staple__legs" d="M10 10 V40 M110 10 V40" stroke={legs} stroke-width="8" stroke-linecap="round"></path>
  <path class="staple__crown" d="M10 10 H110" pathLength="100" stroke={crown} stroke-width="8" stroke-linecap="round"></path>
</svg>

<style>
  .staple {
    overflow: visible;
  }

  .staple__crown {
    stroke-dasharray: 100;
  }

  .staple--stretch path {
    vector-effect: non-scaling-stroke;
    stroke-width: 0.085em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .staple--animated .staple__crown {
      animation: staple-crown 0.5s var(--ease-out) 0.55s both;
    }

    .staple--animated .staple__legs {
      animation: staple-press 0.4s cubic-bezier(0.16, 1, 0.3, 1) 1s both;
    }
  }

  @keyframes staple-crown {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes staple-press {
    from {
      transform: translateY(-10px);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
</style>
