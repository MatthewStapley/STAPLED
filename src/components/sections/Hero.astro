---
import BrowserMockup from "../mockups/BrowserMockup.astro";
import PhoneMockup from "../mockups/PhoneMockup.astro";
import FallbackScreen from "../mockups/FallbackScreen.astro";
import { ctas, images } from "../../data/config";
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <div class="hero__copy reveal">
      <p class="eyebrow">Web design for Southampton businesses</p>
      <h1 class="hero__headline">
        Websites that make local businesses <span class="hero__accent-line">impossible to overlook<span class="hero__dot">.</span></span>
      </h1>
      <p class="hero__sub">
        Stapled. designs and builds modern, fast, mobile-friendly websites for
        Southampton businesses, then keeps them hosted, updated and in good
        shape on Google — from barbers and tradespeople to restaurants and
        independent shops.
      </p>
      <div class="hero__actions">
        <a href={ctas.primary.href} class="btn btn--primary">
          {ctas.primary.label}
        </a>
        <a href={ctas.work.href} class="link-arrow">
          {ctas.work.label}
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <p class="hero__trust">&pound;50 a month &bull; 12-month minimum with an early-exit option &bull; Built personally by Matt</p>
    </div>

    <div class="hero__visual reveal" style="--reveal-index: 2">
      <div class="hero__staple" aria-hidden="true">
        <svg viewBox="0 0 120 60" fill="none">
          <path d="M15 40 V18 a12 12 0 0 1 12 -12 h66 a12 12 0 0 1 12 12 v22" stroke="#C8F560" stroke-width="4" stroke-linecap="round"/>
          <line x1="15" y1="18" x2="15" y2="48" stroke="#C8F560" stroke-width="4" stroke-linecap="round"/>
          <line x1="105" y1="18" x2="105" y2="48" stroke="#C8F560" stroke-width="4" stroke-linecap="round"/>
        </svg>
      </div>

      <div class="hero__desktop">
        <BrowserMockup src={images.barberWarnzDesktop} alt="Barber Warnz website preview on desktop" url="barberwarnz.co.uk" priority>
          <Fragment slot="fallback">
            <FallbackScreen variant="barber-desktop" />
          </Fragment>
        </BrowserMockup>
      </div>

      <div class="hero__mobile">
        <PhoneMockup src={images.barberWarnzMobile} alt="Barber Warnz website preview on mobile" priority>
          <Fragment slot="fallback">
            <FallbackScreen variant="barber-mobile" />
          </Fragment>
        </PhoneMockup>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 8vw, 6rem);
    position: relative;
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  .hero__headline {
    font-size: clamp(2.4rem, 5.4vw, 4.4rem);
    margin-top: 1rem;
    max-width: 16ch;
  }

  .hero__dot {
    color: var(--colour-lime);
  }

  .hero__sub {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    color: var(--colour-muted);
    max-width: 42ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.75rem;
    margin-top: 2.25rem;
  }

  .hero__trust {
    margin-top: 1.75rem;
    font-size: 0.85rem;
    color: var(--colour-muted);
  }

  .hero__visual {
    position: relative;
    padding-block: 1rem;
  }

  .hero__staple {
    position: absolute;
    top: -2.5rem;
    right: 4%;
    width: 90px;
    opacity: 0.9;
    z-index: 1;
  }

  .hero__desktop {
    width: min(100%, 560px);
    margin-inline: auto;
  }

  .hero__mobile {
    position: absolute;
    bottom: -8%;
    right: -2%;
    width: 150px;
    filter: drop-shadow(0 20px 40px rgb(17 17 17 / 0.2));
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__desktop {
      animation: float-desktop 7s ease-in-out infinite;
    }

    .hero__mobile {
      animation: float-mobile 7s ease-in-out infinite;
      animation-delay: 0.3s;
    }
  }

  @keyframes float-desktop {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes float-mobile {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
    }

    .hero__mobile {
      width: 190px;
      bottom: -10%;
      right: 2%;
    }
  }

  @media (max-width: 520px) {
    .hero__mobile {
      width: 118px;
      bottom: -6%;
      right: 0;
    }

    .hero__staple {
      width: 64px;
      top: -1.5rem;
      right: 2%;
    }
  }
</style>
