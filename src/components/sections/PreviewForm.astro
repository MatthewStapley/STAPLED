---
// Enquiries currently come in by email only. The FormSubmit form that was
// here was taken down on 22 Oct 2026 because its data processing terms
// couldn't be verified (see the private asset register). The old form, with
// its accessible validation, is in git history if a verified form service
// replaces it later.
import { contact } from "../../data/config";

const subject = "Homepage preview request";
const body = [
  "Hi Matt,",
  "",
  "My name:",
  "Business name:",
  "Type of business:",
  "Current website or social media page (if any):",
  "What I'd like the website to achieve:",
  "",
].join("\n");
const mailto = `mailto:${contact.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---

<section class="preview section" id="preview" data-dark>
  <div class="container preview__inner">
    <div class="preview__copy reveal">
      <p class="eyebrow">Free homepage preview</p>
      <h2 class="preview__heading">See what your new website could look like.</h2>
      <p class="preview__sub">
        Tell me a little about your business and I'll put together an
        initial homepage direction, with no pressure to continue.
      </p>

      <ul class="preview__expect">
        <li>A short look at how your homepage could feel and read</li>
        <li>Direct feedback from Matt, not a sales team</li>
        <li>No cost and no obligation to continue</li>
      </ul>
    </div>

    <div class="preview__card reveal">
      <h3 class="preview__card-heading">Email me about your business</h3>
      <p class="preview__card-intro">It helps to include:</p>
      <ul class="preview__include">
        <li>your name and business name</li>
        <li>what type of business it is</li>
        <li>your current website or social media page, if you have one</li>
        <li>what you'd like the website to achieve</li>
      </ul>
      <p class="preview__card-note">
        Add a phone number only if you'd rather I called you.
      </p>

      <a href={mailto} class="btn btn--lime preview__email">
        Email {contact.email}
      </a>

      <p class="preview__disclaimer">
        The button opens your email app with these headings filled in. If it
        doesn't, write to <a href={`mailto:${contact.email}`}>{contact.email}</a>.
        I use your details to reply and prepare your preview. See the{" "}
        <a href="/privacy/">privacy policy</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .preview__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: start;
  }

  .preview__heading {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-top: 0.75rem;
    max-width: 16ch;
  }

  .preview__sub {
    margin-top: 1.25rem;
    font-size: 1.1rem;
    color: rgb(245 243 238 / 0.75);
    max-width: 42ch;
  }

  .preview__expect,
  .preview__include {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .preview__expect {
    margin-top: 1.75rem;
  }

  .preview__expect li,
  .preview__include li {
    padding-left: 1.4rem;
    position: relative;
    font-size: 0.95rem;
  }

  .preview__expect li {
    color: rgb(245 243 238 / 0.85);
  }

  .preview__expect li::before,
  .preview__include li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--colour-lime);
  }

  .preview__include li::before {
    outline: 1px solid var(--colour-lime-ink);
    outline-offset: -1px;
  }

  .preview__card {
    background: var(--colour-bg);
    color: var(--colour-ink);
    border-radius: var(--radius-lg);
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  /* The card is light inside a dark section, so the dark section's lime
     focus ring would be invisible here. */
  .preview__card :focus-visible {
    outline-color: var(--colour-ink);
  }

  .preview__card-heading {
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
  }

  .preview__card-intro {
    margin-top: 1rem;
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .preview__card-note {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--colour-muted);
  }

  .preview__email {
    width: 100%;
    margin-top: 1.75rem;
    overflow-wrap: anywhere;
  }

  .preview__disclaimer {
    margin-top: 1rem;
    font-size: 0.82rem;
    color: var(--colour-muted);
    line-height: 1.5;
  }

  @media (min-width: 780px) {
    .preview__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }
</style>
