---
const points = [
  "Mobile-first design",
  "Fast loading",
  "Clear pricing",
  "Personal support",
  "Southampton-based",
  "Built around your business",
];
---

<section class="trust" aria-label="Why work with Stapled.">
  <div class="container">
    <ul class="trust__list">
      {points.map((point) => (
        <li>
          <span class="trust__dot" aria-hidden="true"></span>
          {point}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust {
    border-top: 1px solid var(--colour-border);
    border-bottom: 1px solid var(--colour-border);
    padding-block: 1.4rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .trust::-webkit-scrollbar {
    display: none;
  }

  .trust__list {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--colour-muted);
  }

  .trust__list li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    white-space: nowrap;
  }

  .trust__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--colour-lime);
    flex-shrink: 0;
  }

  @media (max-width: 720px) {
    .trust__list {
      flex-wrap: nowrap;
      justify-content: flex-start;
      width: max-content;
      margin-inline: auto;
    }
  }
</style>
