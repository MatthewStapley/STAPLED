---
// Full standalone concept builds, distinct from the visual-only cards in
// Work.astro: each one links through to its own page with its own brand
// system. Currently ships with one entry (Crema Current); more can be
// added to `interactiveConcepts` in src/data/config.ts later, each paired
// with its own page under src/pages/concepts/ and fallback variant in
// FallbackScreen.astro — this section's markup doesn't need to change.
import BrowserMockup from "../mockups/BrowserMockup.astro";
import FallbackScreen from "../mockups/FallbackScreen.astro";
import ConceptBadge from "../ConceptBadge.astro";
import { interactiveConcepts } from "../../data/config";
---

<section class="concepts section" id="concepts">
  <div class="container">
    <div class="concepts__intro reveal">
      <p class="eyebrow">Interactive Concepts</p>
      <h2 class="concepts__heading">A closer look at what's possible.</h2>
      <p class="text-muted concepts__sub">
        Full concept builds for different local trades. Fictional
        businesses, built to show the range of what Stapled could design
        for yours.
      </p>
    </div>

    <!-- Rendered as a single wide feature card while there's one concept.
         Once a second entry exists in interactiveConcepts, switch this
         wrapper to a grid (matching the Work section's card grid) so
         multiple concepts sit side by side. -->
    <div class="concepts__list">
      {interactiveConcepts.map((concept) => (
        <a href={`/concepts/${concept.slug}/`} class="concepts__card reveal">
          <div class="concepts__card-visual">
            <BrowserMockup
              src={concept.image}
              alt={`${concept.name} concept website on desktop`}
              url={`stapled.co.uk/concepts/${concept.slug}`}
            >
              <Fragment slot="fallback">
                <FallbackScreen variant="crema-current-desktop" />
              </Fragment>
            </BrowserMockup>
          </div>
          <div class="concepts__card-copy">
            <ConceptBadge />
            <h3>{concept.name}</h3>
            <p class="text-muted concepts__card-category">{concept.category}</p>
            <p class="text-muted">{concept.tagline}</p>
            <span class="link-arrow">
              Explore the concept
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .concepts__intro {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    max-width: 56ch;
  }

  .concepts__heading {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-top: 0.75rem;
  }

  .concepts__sub {
    margin-top: 1rem;
    font-size: 1.05rem;
  }

  .concepts__list {
    display: grid;
    gap: 1.5rem;
  }

  .concepts__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
    text-decoration: none;
    color: inherit;
    background: var(--colour-white);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }

  .concepts__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 30px 50px -30px rgb(17 17 17 / 0.25);
  }

  .concepts__card-visual {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .concepts__card:hover .concepts__card-visual {
    transform: scale(1.015);
  }

  .concepts__card-copy h3 {
    font-size: clamp(1.4rem, 2.5vw, 1.75rem);
    margin: 0.85rem 0 0.25rem;
  }

  .concepts__card-category {
    font-size: 0.85rem;
    margin-bottom: 0.6rem;
  }

  .concepts__card-copy .link-arrow {
    margin-top: 1.25rem;
  }

  @media (min-width: 780px) {
    .concepts__card {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }
</style>
