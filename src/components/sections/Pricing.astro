---
import { ctas } from "../../data/config";

const factors = [
  "Number of pages",
  "Amount of written content",
  "Required features",
  "Branding requirements",
  "Google Business support",
  "Additional services",
];
---

<section class="pricing section" id="pricing" data-dark>
  <div class="container pricing__inner">
    <div class="pricing__copy reveal">
      <p class="eyebrow">Pricing</p>
      <h2 class="pricing__heading">Straightforward pricing, built around the job.</h2>
      <p class="pricing__range">
        Most Stapled. websites cost between <strong>&pound;400</strong> and <strong>&pound;800</strong>.
      </p>
      <p class="text-muted">
        The final price depends on a few things, and I'll always agree it
        with you upfront before any work starts:
      </p>

      <ul class="pricing__factors">
        {factors.map((f) => (
          <li>{f}</li>
        ))}
      </ul>

      <p class="text-muted pricing__note">
        Optional hosting and ongoing support are available and can be
        discussed separately, once you know what your website needs.
      </p>

      <a href={ctas.quote.href} class="btn btn--lime">
        {ctas.quote.label}
      </a>
    </div>
  </div>
</section>

<style>
  .pricing__inner {
    display: flex;
    justify-content: center;
  }

  .pricing__copy {
    max-width: 640px;
    text-align: center;
  }

  .pricing__heading {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-top: 0.75rem;
  }

  .pricing__range {
    font-size: 1.4rem;
    font-family: var(--font-display);
    font-weight: 600;
    margin-top: 1.5rem;
  }

  .pricing__range strong {
    color: var(--colour-lime);
  }

  .pricing__factors {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .pricing__factors li {
    border: 1px solid rgb(245 243 238 / 0.4);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    font-size: 0.85rem;
  }

  .pricing__note {
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }

  .pricing__copy .btn {
    margin-top: 2.25rem;
  }
</style>
