---
import { ctas } from "../../data/config";

const included = [
  "Design and build",
  "Hosting",
  "Small updates and changes",
  "Ongoing support",
  "Mobile-first",
];

const terms = [
  "Pay £50 to start — that covers your first month.",
  "12-month minimum, then carry on month to month.",
  "If you cancel after that, your website comes down.",
];
---

<section class="pricing section" id="pricing" data-dark>
  <div class="container pricing__inner">
    <div class="pricing__copy reveal">
      <p class="eyebrow">Pricing</p>
      <h2 class="pricing__heading">One simple monthly price. No big upfront bill.</h2>
      <p class="pricing__range">
        <strong>&pound;50</strong> a month for your website.
      </p>
      <p class="text-muted">
        I design and build your website, host it, and keep it looking right
        for you. Everything you need is included:
      </p>

      <ul class="pricing__factors">
        {included.map((f) => (
          <li>{f}</li>
        ))}
      </ul>

      <ul class="pricing__terms">
        {terms.map((t) => (
          <li>{t}</li>
        ))}
      </ul>

      <p class="text-muted pricing__note">
        Want to own it outright? You can buy your website from me for a
        one-off <strong>&pound;499</strong> at any time. You get the site to keep and
        host wherever you like &mdash; hosting, updates and support from me stop at
        that point.
      </p>

      <a href={ctas.quote.href} class="btn btn--lime">
        {ctas.quote.label}
      </a>
    </div>
  </div>
</section>

<style>
  .pricing__inner {
    display: flex;
    justify-content: center;
  }

  .pricing__copy {
    max-width: 640px;
    text-align: center;
  }

  .pricing__heading {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-top: 0.75rem;
  }

  .pricing__range {
    font-size: 1.4rem;
    font-family: var(--font-display);
    font-weight: 600;
    margin-top: 1.5rem;
  }

  .pricing__range strong {
    color: var(--colour-lime);
  }

  .pricing__factors {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .pricing__factors li {
    border: 1px solid rgb(245 243 238 / 0.4);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    font-size: 0.85rem;
  }

  .pricing__terms {
    display: grid;
    gap: 0.4rem;
    margin-top: 1.75rem;
    font-size: 0.95rem;
  }

  .pricing__note strong {
    color: var(--colour-lime);
  }

  .pricing__note {
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }

  .pricing__copy .btn {
    margin-top: 2.25rem;
  }
</style>
