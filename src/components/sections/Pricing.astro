---
import { ctas } from "../../data/config";

const included = [
  "Custom website design and build",
  "Hosting and maintenance",
  "Content updates",
  "Google Business Profile management",
  "Check-ins every two weeks",
];

const terms = [
  "Your first £50 is paid when you sign up and covers your first month.",
  "After the first 12 months, it carries on at £50 a month until you cancel with 30 days’ notice.",
  "If you cancel, I give you notice and hand back your content and domain before the website goes offline.",
];
---

<section class="pricing section" id="pricing" data-dark>
  <div class="container pricing__inner">
    <div class="pricing__copy reveal">
      <p class="eyebrow">Pricing</p>
      <h2 class="pricing__heading">One monthly plan. Your website, looked after.</h2>
      <p class="pricing__range">
        <strong>&pound;50</strong> a month
      </p>
      <p class="pricing__minimum">12-month minimum, then monthly until you cancel</p>
      <p class="text-muted">
        A professional website for your business, plus ongoing support from
        me. Everything below is included:
      </p>

      <ul class="pricing__factors">
        {included.map((f) => (
          <li>{f}</li>
        ))}
      </ul>

      <ul class="pricing__terms">
        {terms.map((t) => (
          <li>{t}</li>
        ))}
      </ul>

      <p class="text-muted pricing__note">
        Prefer to own the website yourself? You can buy it outright for a
        one-off <strong>&pound;499</strong>. After that, my monthly services
        stop and you look after the hosting.
      </p>

      <a href={ctas.primary.href} class="btn btn--lime">
        {ctas.primary.label}
      </a>
    </div>
  </div>
</section>

<style>
  .pricing__inner {
    display: flex;
    justify-content: center;
  }

  .pricing__copy {
    max-width: 640px;
    text-align: center;
  }

  .pricing__heading {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-top: 0.75rem;
  }

  .pricing__range {
    font-size: 1.4rem;
    font-family: var(--font-display);
    font-weight: 600;
    margin-top: 1.5rem;
  }

  .pricing__minimum {
    margin-top: 0.35rem;
    margin-bottom: 1rem;
    font-weight: 600;
    color: var(--colour-bg);
  }

  .pricing__range strong {
    color: var(--colour-lime);
  }

  .pricing__factors {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .pricing__factors li {
    border: 1px solid rgb(245 243 238 / 0.4);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    font-size: 0.85rem;
  }

  .pricing__terms {
    display: grid;
    gap: 0.4rem;
    margin-top: 1.75rem;
    font-size: 0.95rem;
  }

  .pricing__note strong {
    color: var(--colour-lime);
  }

  .pricing__note {
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }

  .pricing__copy .btn {
    margin-top: 2.25rem;
  }
</style>
