---
// Homepage hero: what Stapled. does, said once. The staple fastens the
// headline (the site's signature motion), and the main call to action eases
// slightly towards the pointer on desktop (the magnetic script lives in
// Layout.astro).
import StapleMark from "../ui/StapleMark.astro";
import { ctas, site } from "../../data/config";

const trades = [
  "Roofing",
  "Tarmac and driveways",
  "Landscaping",
  "Bathrooms and kitchens",
  "Plumbing and heating",
];
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <p class="eyebrow hero__eyebrow">{site.location}</p>
    <h1 id="hero-heading" class="display hero__heading">
      <span class="hero__line">Your work is good.</span>
      <span class="hero__line">Your website should{" "}<span class="hero__fasten">show it.<StapleMark class="hero__staple" animated stretch /></span></span>
    </h1>

    <div class="hero__row">
      <div class="hero__copy">
        <p class="lead hero__lead">
          Websites, Google support and simpler enquiries for trade and service
          businesses. Designed, built and looked after personally by Matt.
        </p>
        <div class="hero__actions">
          <a href={ctas.primary.href} class="btn btn--lime" data-magnetic>
            <span class="btn__label">
              {ctas.primary.label}
              <svg class="btn__arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </span>
          </a>
          <a href="#demo" class="link-arrow">
            See the bathroom demo
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
        </div>
      </div>
      <div class="hero__trades">
        <p class="hero__trades-label">Especially for</p>
        <ul class="trades">
          {trades.map((t) => <li>{t}</li>)}
          <li class="trades__other">and other service businesses</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 7vw, 6.5rem) clamp(3rem, 6vw, 5rem);
  }

  .hero__heading {
    margin-top: 1.5rem;
  }

  .hero__line {
    display: block;
  }

  .hero__fasten {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  .hero__fasten :global(.hero__staple) {
    position: absolute;
    left: -1%;
    top: 96%;
    width: 102%;
    height: 0.22em;
  }

  .hero__row {
    margin-top: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem 3rem;
  }

  .hero__copy {
    max-width: 34rem;
  }

  .hero__actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
  }

  .hero__trades {
    max-width: 30rem;
  }

  .hero__trades-label {
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--colour-muted);
  }

  .trades {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .trades li {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 0.95rem;
    border: 1px solid var(--colour-border);
    border-radius: 999px;
    background: var(--colour-white);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .trades .trades__other {
    border-style: dashed;
    background: transparent;
    color: var(--colour-text-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__eyebrow,
    .hero__heading,
    .hero__row {
      animation: hero-rise 0.8s var(--ease-out) both;
    }

    .hero__heading {
      animation-delay: 0.08s;
    }

    .hero__row {
      animation-delay: 0.18s;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
