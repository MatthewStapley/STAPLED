---
// "What Stapled. does": the four services in one compact band. The detail
// lives on /services/.
import { services } from "../../data/services";
---

<section class="svc" id="services" aria-labelledby="svc-heading">
  <div class="container">
    <div class="svc__head">
      <h2 id="svc-heading" class="svc__heading">What I do</h2>
      <a href="/services/" class="link-arrow">
        Services in detail
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
    </div>
    <ol class="svc__grid">
      {services.map((s) => (
        <li class="svc__item">
          <a class="svc__link" href={`/services/#${s.id}`}>
            <span class="svc__num" aria-hidden="true">{s.n}</span>
            <h3 class="svc__title">{s.title}</h3>
            <p class="svc__body">{s.short}</p>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .svc {
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--colour-white);
    border-block: 1px solid var(--colour-border);
  }

  .svc__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 2rem;
  }

  .svc__heading {
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    letter-spacing: -0.03em;
  }

  .svc__grid {
    margin-top: 1.75rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--colour-border);
  }

  .svc__item + .svc__item {
    border-left: 1px solid var(--colour-border);
  }

  .svc__link {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.6rem;
    height: 100%;
    padding: 1.5rem 1.5rem 1.75rem;
    text-decoration: none;
    transition: background 0.35s var(--ease-out);
  }

  /* A lime rule fastens along the top of the card on hover or focus. */
  .svc__link::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 3px;
    background: var(--colour-lime);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }

  .svc__link:hover,
  .svc__link:focus-visible {
    background: var(--colour-bg);
  }

  .svc__link:hover::before,
  .svc__link:focus-visible::before {
    transform: scaleX(1);
  }

  .svc__num {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--colour-muted);
  }

  .svc__title {
    font-size: 1.3rem;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .svc__body {
    color: var(--colour-text-2);
    line-height: 1.55;
    font-size: 0.98rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .svc__link::before {
      transition: none;
    }
  }

  @media (max-width: 1000px) {
    .svc__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .svc__item:nth-child(3) {
      border-left: 0;
    }

    .svc__item:nth-child(n + 3) {
      border-top: 1px solid var(--colour-border);
    }

  }

  @media (max-width: 600px) {
    .svc__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .svc__item + .svc__item {
      border-left: 0;
      border-top: 1px solid var(--colour-border);
    }

    .svc__link {
      padding: 1.25rem 0.75rem;
    }
  }
</style>
