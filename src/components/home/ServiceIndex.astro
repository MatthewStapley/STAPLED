---
// Numbered service rows. Each row's illustration wipes in as it scrolls
// into view (CSS scroll timelines only; static everywhere else).
import Illustration from "../ui/Illustration.astro";
import { services } from "../../data/services";
---

<section class="svc section" id="services" aria-labelledby="svc-heading">
  <div class="container">
    <p class="eyebrow">Services</p>
    <h2 id="svc-heading" class="headline svc__heading">Everything your customers check before they call.</h2>
    <p class="lead svc__lead">
      Most people look you up before they pick up the phone. I make sure what
      they find is clear, current and easy to act on.
    </p>

    <ol class="svc__list">
      {services.map((s) => (
        <li class="svc__row">
          <span class="svc__num" aria-hidden="true">{s.n}</span>
          <h3 class="svc__title">{s.title}</h3>
          <p class="svc__body">{s.summary}</p>
          <div class="svc__art">
            <Illustration variant={s.art} />
          </div>
        </li>
      ))}
    </ol>

    <a href="/services/" class="link-arrow svc__more">
      More about each service
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
  </div>
</section>

<style>
  .svc {
    background: var(--colour-white);
    border-block: 1px solid var(--colour-border);
  }

  .svc__heading {
    margin-top: 1.5rem;
  }

  .svc__lead {
    margin-top: 1.5rem;
  }

  .svc__list {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--colour-border);
  }

  .svc__row {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1.1fr) minmax(0, 1fr) 15rem;
    gap: clamp(1.25rem, 3vw, 3rem);
    align-items: center;
    padding-block: clamp(1.75rem, 3.5vw, 3rem);
    border-bottom: 1px solid var(--colour-border);
  }

  .svc__num {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--colour-border-strong);
  }

  .svc__title {
    font-size: clamp(1.5rem, 2.4vw, 2.2rem);
    font-weight: 620;
    letter-spacing: -0.025em;
  }

  .svc__body {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--colour-text-2);
  }

  .svc__art {
    background: var(--colour-graphite);
    border-radius: 20px;
    padding: 1rem;
  }

  .svc__more {
    margin-top: 2rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .svc__art {
        animation: svc-wipe linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 35%;
      }
    }
  }

  @keyframes svc-wipe {
    from {
      clip-path: inset(0 100% 0 0 round 20px);
    }
    to {
      clip-path: inset(0 0 0 0 round 20px);
    }
  }

  @media (max-width: 1100px) {
    .svc__row {
      grid-template-columns: 4.5rem minmax(0, 1fr) minmax(0, 1fr);
    }

    .svc__art {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .svc__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }
  }
</style>
