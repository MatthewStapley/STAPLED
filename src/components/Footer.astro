---
import Wordmark from "./Wordmark.astro";
import { nav, contact, site, business } from "../data/config";

const year = new Date().getFullYear();
---

<footer class="footer" data-dark>
  <div class="container footer__inner">
    <div class="footer__top">
      <div class="footer__brand">
        <Wordmark size="lg" light />
        <p class="text-muted footer__location">{site.location}</p>
        <p class="text-muted footer__business">
          {business.proprietor} trading as {business.tradingAs}
        </p>
      </div>

      <nav class="footer__nav" aria-label="Footer">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href} class="footer__link">{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <ul class="footer__contact">
        <li>
          <a href={`mailto:${contact.email}`} class="footer__link">{contact.email}</a>
        </li>
        {contact.instagramLink && (
          <li>
            <a href={contact.instagramLink} class="footer__link" target="_blank" rel="noopener noreferrer">
              {contact.instagramHandle} on Instagram<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
        )}
      </ul>
    </div>

    <div class="footer__bottom">
      <p>{site.tagline}</p>
      <div class="footer__legal">
        <p>&copy; {year} {business.proprietor} trading as {business.tradingAs}</p>
        <nav aria-label="Legal">
          <ul>
            <li><a href="/terms/">Terms</a></li>
            <li><a href="/privacy/">Privacy policy</a></li>
            <li><a href="/business-details/">Business details</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgb(245 243 238 / 0.15);
  }

  .footer__location {
    margin-top: 0.75rem;
    font-size: 0.9rem;
  }

  .footer__nav ul,
  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer__nav a,
  .footer__contact a {
    overflow-wrap: anywhere;
    text-decoration: none;
    font-size: 0.95rem;
    color: rgb(245 243 238 / 0.8);
  }

  .footer__nav a:hover,
  .footer__contact a:hover {
    color: var(--colour-lime);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 1.75rem;
    font-size: 0.82rem;
    color: rgb(245 243 238 / 0.55);
  }

  .footer__business {
    margin-top: 0.4rem;
    font-size: 0.9rem;
  }

  .footer__legal,
  .footer__legal ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }

  /* Comfortable tap targets on small text links (WCAG 2.2 target size). */
  .footer__legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer__legal a {
    color: rgb(245 243 238 / 0.8);
    text-underline-offset: 0.2em;
  }

  .footer__legal a:hover {
    color: var(--colour-lime);
  }

  @media (min-width: 720px) {
    .footer__top {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
