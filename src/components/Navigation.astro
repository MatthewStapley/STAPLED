---
import Wordmark from "./Wordmark.astro";
import { nav, ctas } from "../data/config";
---

<header class="nav" id="site-nav">
  <div class="container nav__inner">
    <a href="#top" class="nav__brand" aria-label="Stapled. — home">
      <Wordmark size="md" />
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav__actions">
      <a href={ctas.primary.href} class="btn btn--lime btn--sm">
        Free homepage preview
      </a>
    </div>

    <button
      class="nav__toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Mobile">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} class="mobile-menu__link">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a href={ctas.primary.href} class="btn btn--lime" id="mobile-menu-cta">
      Free homepage preview
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(245 243 238 / 0);
    border-bottom: 1px solid transparent;
    transition: background var(--dur-mid) var(--ease-out),
      border-color var(--dur-mid) var(--ease-out),
      box-shadow var(--dur-mid) var(--ease-out);
  }

  /* The frosted background lives on a pseudo-element, not on .nav itself:
     backdrop-filter on .nav would make it the containing block for the
     position: fixed mobile menu, shrinking the "full-screen" menu to the
     height of the header once the page is scrolled. */
  .nav::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: transparent;
    transition: background var(--dur-mid) var(--ease-out);
  }

  .nav[data-scrolled] {
    border-bottom-color: var(--colour-border);
    box-shadow: 0 8px 30px -20px rgb(17 17 17 / 0.25);
  }

  .nav[data-scrolled]::before {
    background: rgb(245 243 238 / 0.85);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  /* Sits above the open mobile menu so the logo and close button stay
     visible and tappable. */
  .nav__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.1rem;
  }

  .nav__brand {
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav__links ul {
    display: flex;
    gap: 2rem;
  }

  .nav__links a {
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--colour-ink);
    position: relative;
    padding-block: 0.3rem;
  }

  .nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--colour-lime);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .nav__links a:hover::after,
  .nav__links a:focus-visible::after {
    transform: scaleX(1);
  }

  .nav__actions {
    flex-shrink: 0;
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: 1px solid var(--colour-border);
    background: var(--colour-white);
    cursor: pointer;
    flex-shrink: 0;
  }

  .nav__toggle span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--colour-ink);
    transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
  }

  .nav__toggle[aria-expanded="true"] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .nav__toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    background: var(--colour-bg);
    z-index: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2.5rem;
    padding: 6rem 2rem 3rem;
    animation: menu-in var(--dur-mid) var(--ease-out);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu ul {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .mobile-menu__link {
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    color: var(--colour-ink);
  }

  @media (max-width: 860px) {
    .nav__links,
    .nav__actions {
      display: none;
    }

    .nav__toggle {
      display: flex;
    }
  }
</style>

<script>
  const nav = document.getElementById("site-nav");
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");

  const setScrolled = () => {
    if (!nav) return;
    if (window.scrollY > 12) {
      nav.setAttribute("data-scrolled", "");
    } else {
      nav.removeAttribute("data-scrolled");
    }
  };

  setScrolled();
  window.addEventListener("scroll", setScrolled, { passive: true });

  // Elements visually covered by the full-screen mobile menu but not
  // removed from the DOM — inert them while the menu is open so keyboard
  // and screen-reader users can't tab into content they can't see.
  const inertTargets = [
    document.getElementById("main"),
    document.querySelector("footer"),
    document.querySelector(".skip-link"),
  ].filter((el) => el !== null);

  const setBackgroundInert = (value) => {
    inertTargets.forEach((el) => {
      el.inert = value;
    });
  };

  // Lock page scroll by pinning the body in place. overflow: hidden alone
  // doesn't stop scrolling on iOS Safari. The saved position is restored
  // instantly on close so the page doesn't jump or smooth-scroll back.
  let lockedScrollY = 0;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const lockScroll = () => {
    lockedScrollY = window.scrollY;
    const body = document.body.style;
    body.position = "fixed";
    body.top = `-${lockedScrollY}px`;
    body.left = "0";
    body.right = "0";
    body.overflow = "hidden";
  };

  const unlockScroll = () => {
    ["position", "top", "left", "right", "overflow"].forEach((prop) =>
      document.body.style.removeProperty(prop)
    );
    window.scrollTo({ top: lockedScrollY, behavior: "instant" });
  };

  const isOpen = () => toggle?.getAttribute("aria-expanded") === "true";

  const closeMenu = (restoreFocus = true) => {
    if (!toggle || !menu || !isOpen()) return;
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Open menu");
    menu.hidden = true;
    setBackgroundInert(false);
    unlockScroll();
    if (restoreFocus) toggle.focus({ preventScroll: true });
  };

  const openMenu = () => {
    if (!toggle || !menu || isOpen()) return;
    lockScroll();
    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", "Close menu");
    menu.hidden = false;
    setBackgroundInert(true);
    menu.querySelector(".mobile-menu__link")?.focus({ preventScroll: true });
  };

  toggle?.addEventListener("click", () => {
    isOpen() ? closeMenu() : openMenu();
  });

  // Close the menu if the screen widens to the desktop layout while open.
  window.matchMedia("(min-width: 861px)").addEventListener("change", (e) => {
    if (e.matches) closeMenu(false);
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", (e) => {
      const url = new URL(link.href);
      const target =
        url.pathname === window.location.pathname && url.hash
          ? document.querySelector(url.hash)
          : null;

      // Off-page links navigate normally.
      if (!target) {
        closeMenu(false);
        return;
      }

      // Same-page links: unlock the page first, then scroll to the section.
      // Left to the browser, the jump fires while the body is still pinned
      // and gets lost when the saved scroll position is restored.
      e.preventDefault();
      closeMenu(false);
      history.pushState(null, "", url.hash);
      target.scrollIntoView({ behavior: reducedMotion.matches ? "auto" : "smooth" });
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });
</script>
